# ---------------------------------------------------------------------------
# Copy to `.env` and edit. `.env` is gitignored and must never be committed.
#   cp .env.example .env
# Every value below has a working default — an empty .env still runs the demo.
# ---------------------------------------------------------------------------

# --- What to track ---------------------------------------------------------
# Comma-separated public profile handles. Also addable at runtime:
#   python cli.py add-target some_page
IG_TARGETS=campus_confessions,city_secrets_page

# --- Which backend does the scraping ---------------------------------------
#   demo         synthetic data, no network, no credentials  (default)
#   playwright   headless Chromium, needs the login below
#   instaloader  the instaloader library, needs the login below
IG_SCRAPER_BACKEND=demo

# --- Login (only for the live backends) ------------------------------------
# Use a throwaway account, not your main one: automated collection can get an
# account rate-limited, challenged, or disabled.
# The password is needed ONCE to mint a session; after that the stored cookies
# are reused and you can blank it out again.
IG_USERNAME=
IG_PASSWORD=

# --- Storage ---------------------------------------------------------------
# Default is SQLite under ./runtime/. For Postgres:
#   IG_DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/tracker
IG_DATABASE_URL=
IG_DATA_DIR=
IG_LOG_LEVEL=INFO

# --- Scheduling ------------------------------------------------------------
# 15min | 30min | hourly | 6hourly | 12hourly | daily | weekly | <minutes>
IG_SCRAPE_INTERVAL=hourly
IG_SCHEDULE_JITTER=180          # +/- seconds, so runs are not clockwork
IG_RUN_ON_START=true

# --- Politeness / anti-block ----------------------------------------------
# These defaults are deliberately slow. Lowering them raises the odds of a
# rate limit, a challenge, or a disabled account — the tool gets *less*
# reliable, not faster.
IG_MIN_REQUEST_DELAY=2.5        # seconds, randomised between min and max
IG_MAX_REQUEST_DELAY=6.0
IG_MAX_REQUESTS_PER_HOUR=180
IG_MAX_RETRIES=5
IG_BACKOFF_BASE=3.0             # exponential: base * 2**attempt, jittered
IG_BACKOFF_MAX=300.0
IG_REQUEST_TIMEOUT=45.0
IG_PAGE_SIZE=50                 # followers per request; 50 is what the web app uses
IG_MAX_FOLLOWERS_PER_RUN=0      # 0 = no cap. A capped run is flagged PARTIAL.

# --- Browser (playwright backend) -----------------------------------------
IG_HEADLESS=true                # set false to solve a login challenge by hand
IG_BROWSER_CHANNEL=             # e.g. "chrome" to use installed Chrome
IG_LOCALE=en-US
IG_TIMEZONE_ID=Asia/Kolkata
IG_USER_AGENT=

# --- Proxy (optional) ------------------------------------------------------
# e.g. http://gateway.provider.test:8000  or  socks5://127.0.0.1:1080
IG_PROXY_SERVER=
IG_PROXY_USERNAME=
IG_PROXY_PASSWORD=

# --- Diff safety -----------------------------------------------------------
# If one run would remove more than this fraction of the known follower set,
# it is treated as a short read: the snapshot is marked PARTIAL and unfollow
# detection is skipped rather than recording a false mass-unfollow.
IG_MAX_UNFOLLOW_RATIO=0.5

# --- Diff safety floor ---
# The ratio guard above only fires once the loss is at least this many
# accounts, so it never trips on a page too small for a percentage to mean
# anything (losing 2 of 3 followers is 67%, and completely normal).
IG_MIN_UNFOLLOWS_FOR_GUARD=10

# --- Dashboard behaviour (matters for hosted deployments) ------------------
# The dashboard is the only interface on a hosted deployment — there is no
# shell to run cli.py in — so by default it can seed demo data and add
# targets. On a PUBLIC deployment backed by real data, turn both OFF:
# otherwise any visitor can write synthetic rows into your live database,
# spend your request budget, or drive a scrape through your logged-in session.
IG_ENABLE_DEMO_SEED=true
IG_ENABLE_WRITE_ACTIONS=true
